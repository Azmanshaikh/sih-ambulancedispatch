# ── Vercel (frontend) ─────────────────────────────────────────────────────────
# These VITE_* values are baked in at BUILD time. Redeploy after changing them.
VITE_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Public FastAPI origin (Render/Railway/Fly). No trailing slash.
VITE_BACKEND_URL=https://your-api.onrender.com

# ── Backend host (Render/Railway/Fly — not Vercel) ────────────────────────────
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Dashboard → Project Settings → API → JWT Secret. Used by FastAPI to verify access tokens locally.
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET
# Optional. Defaults to authenticated / {SUPABASE_URL}/auth/v1
# SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_JWT_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
STAFF_BOOTSTRAP_EMAILS=you@gmail.com
# Comma-separated emails with Main Admin access (route simulation).
MAIN_ADMIN_BOOTSTRAP_EMAILS=azmanshaikh01071@gmail.com
# Optional frontend allow-list display (defaults to the same email when unset).
VITE_MAIN_ADMIN_EMAIL=azmanshaikh01071@gmail.com
# Gmail SMTP / Resend are optional and not used for OTP (codes are admin-only in-app).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=
# SMTP_FROM=you@gmail.com
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# Optional: leave empty. Postgres is not required for the demo fleet.
DATABASE_URL=

# ── AI (backend) ──────────────────────────────────────────────────────────────
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

TAVUS_API_KEY=
TAVUS_REPLICA_ID=r90bbd427f71
TAVUS_PERSONA_ID=
TAVUS_PAL_ID=
TAVUS_FACE_ID=
TAVUS_CALLBACK_URL=
# Shared secret sent as X-Jeevan-Webhook-Secret (required for POST /ai/tavus/webhook).
TAVUS_WEBHOOK_SECRET=

NVIDIA_API_KEY=
# Use a chat model your NVIDIA key can call. 30B/omni models often need extra access.
NVIDIA_MODEL=nvidia/nemotron-mini-4b-instruct
NVIDIA_MODEL_FALLBACKS=meta/llama-3.1-8b-instruct,google/gemma-3-4b-it
# Speech-to-text. Do not set this to NVIDIA_MODEL — mini/instruct chat models are text-only.
NVIDIA_ASR_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_ASR_MODEL_FALLBACKS=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

OPENROUTER_API_KEY=
OPENROUTER_REPORT_MODEL=openrouter/auto
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional live-traffic routing. If empty, public OSRM is used.
TOMTOM_API_KEY=

# Optional corridor SMS. If empty, alerts are recorded in the demo log only.
MSG91_AUTH_KEY=
MSG91_SENDER=JEEVAN
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=
