# ── Supabase (shared by frontend + backend) ───────────────────────────────────
VITE_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Backend (preferred explicit names)
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Backend only — service role key (bypasses RLS)
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ── AI provider (backend proxy) ───────────────────────────────────────────────
# Use "gemini" or "nvidia".
AI_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# NVIDIA NIM / build.nvidia.com
# To use NVIDIA instead of Gemini, keep AI_PROVIDER=nvidia and add your key below.
# Pick a text model from your NVIDIA catalog.
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-nano-8b-v1
NVIDIA_MODEL_FALLBACKS=
NVIDIA_VISION_MODEL=microsoft/phi-3-vision-128k-instruct
NVIDIA_VISION_MODEL_FALLBACKS=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# OpenRouter (report analysis)
# Used by /api/ai/analyze-report for image/text medical reports.
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_REPORT_MODEL=openrouter/auto
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Frontend: backend URL ─────────────────────────────────────────────────────
# Local dev: leave as-is (Vite proxy handles /api and /ws)
# Production: set to your Render service URL
VITE_BACKEND_URL=http://localhost:8000

# Static HTML runtime config (optional)
# If you use the static HTML pages (public/index.html or frontend/index.html),
# run `npm run gen:envjs` to generate env.js from BACKEND_URL/VITE_BACKEND_URL.
# BACKEND_URL takes precedence if set.
# BACKEND_URL=https://your-backend.onrender.com

# ── CORS (backend, production only) ──────────────────────────────────────────
# Set to your Vercel deployment URL after first deploy
# CORS_ORIGINS=https://your-new-app.vercel.app
